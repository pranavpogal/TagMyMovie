MONGODB_URL=
MONGODB_DATABASE=tagmymovie

TMDB_BASE_URL=https://api.themoviedb.org/3/
TMDB_KEY=
TMDB_ACCESS_TOKEN=

CATALOGUE_MOVIE_PAGES=10
CATALOGUE_TV_PAGES=10
CATALOGUE_SYNC_MODE=incremental
CATALOGUE_INCREMENTAL_MAX_AGE_HOURS=24
CATALOGUE_BATCH_SIZE=100
CATALOGUE_CAST_LIMIT=20
CATALOGUE_KEYWORD_LIMIT=30

TMDB_REQUEST_TIMEOUT_SECONDS=10
TMDB_MAX_RETRIES=4
TMDB_RETRY_BACKOFF_SECONDS=0.5
TMDB_REQUESTS_PER_SECOND=4

FEATURE_TEXT_CAST_LIMIT=10
FEATURE_TEXT_KEYWORD_LIMIT=20

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VERSION=content-embedding-v1
EMBEDDING_BATCH_SIZE=64
VECTOR_BACKEND=faiss
VECTOR_INDEX_NAME=media_embedding_index
CONTENT_ARTIFACT_DIRECTORY=artifacts/content
CONTENT_CANDIDATE_LIMIT=150
VECTOR_NUM_CANDIDATES=300

PROFILE_VERSION=user-profile-v1
RECENCY_DECAY_FACTOR=0.98
PROFILE_WEAK_POSITIVE_CAP=2.0
PROFILE_NEGATIVE_CENTROID_SCALE=0.35
